{
  "table": "piano_applications",
  "description": "Submitted piano applications from artists. Users often ask to check or update records (e.g. status, artwork_title, applicant info).",
  "lookup_fields": ["id", "activation", "artwork_title", "status", "applicant_email"],
  "primary_key": "id",
  "columns": {
    "idx": { "type": "number", "editable": false },
    "id": { "type": "number", "editable": false },
    "created_at": { "type": "string", "editable": false },
    "user": { "type": "string", "editable": false },
    "artwork_title": { "type": "string", "editable": true },
    "artist_statement": { "type": "string", "editable": true },
    "design_front": { "type": "string", "editable": true },
    "design_back": { "type": "string", "editable": true },
    "design_sides": { "type": "string", "editable": true },
    "activation": { "type": "string", "editable": false },
    "status": { "type": "string", "editable": true },
    "learn_completion": { "type": "boolean", "editable": true },
    "guidelines_completion": { "type": "boolean", "editable": true },
    "design_completion": { "type": "boolean", "editable": true },
    "profile_completion": { "type": "boolean", "editable": true },
    "info_completion": { "type": "boolean", "editable": true },
    "applicant_email": { "type": "string", "editable": true },
    "first_name": { "type": "string", "editable": true },
    "last_name": { "type": "string", "editable": true },
    "dob": { "type": "string", "editable": true },
    "artist_name": { "type": "string", "editable": true },
    "bio": { "type": "string", "editable": true },
    "avatar_url": { "type": "string", "editable": true },
    "website": { "type": "string", "editable": true },
    "x_url": { "type": "string", "editable": true },
    "insta_url": { "type": "string", "editable": true },
    "facebook_url": { "type": "string", "editable": true },
    "youtube_url": { "type": "string", "editable": true },
    "tiktok_url": { "type": "string", "editable": true }
  }
}
