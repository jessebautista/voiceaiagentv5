# Copy to .env and fill in your values.
# Secrets: API keys for OpenAI and optional Redis/Pinecone.

# Required for the agent (LLM)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Optional: persistent chat memory (Upstash Redis — use REST URL + token from Upstash dashboard)
# UPSTASH_REDIS_REST_URL=https://your-db-id.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Optional: standard Redis (alternative to Upstash)
# REDIS_URL=redis://localhost:6379/0

# Optional: for vector FAQ search (if you add Pinecone)
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_INDEX=your-index-name

# Voice — Live Connect (ElevenLabs). Get API key at https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Optional; default is Rachel

# Supabase (CRUD for news, piano_applications, piano_activations). Table configs in data/tables/*.json
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key   # Optional; service key preferred for server-side CRUD

# Observability (optional)
# LOG_LEVEL=INFO
# LANGCHAIN_API_KEY=your-langsmith-key   # Enables LangSmith tracing at smith.langchain.com

# Server
HOST=0.0.0.0
PORT=8000

# Temporal (Workflow orchestration; dev-fix and other workflows)
# TEMPORAL_URL=localhost:7233     # Local: default. Production: your Temporal server (e.g. Temporal Cloud host:port)

# CORS (for PHWB / dev-fix). Leave unset for localhost-only. Production: comma-separated PHWB frontend URL(s)
# CORS_ORIGINS=https://phwb.example.com,https://admin.singforhope.org

# Dev Agent (bug-fix workflow): GitHub repo to clone and open PRs
# DEV_AGENT_GITHUB_REPO_URL=https://github.com/org/repo.git
# DEV_AGENT_GITHUB_ACCESS_TOKEN=ghp_xxx
# Optional: copy host node_modules into clone (local only; leave unset in production)
# DEV_AGENT_NODE_MODULES_PATH=/path/to/phwb/node_modules

# Emails (Resend API)
# RESEND_API_KEY=re_your-resend-api-key
# FROM_EMAIL=onboarding@resend.dev   # Must be a verified sender domain in production

# Dev agent model routing (optional)
# DEV_AGENT_MODEL_DEFAULT=claude-sonnet-4-6
# DEV_AGENT_MODEL_PLANNER=claude-sonnet-4-6
# DEV_AGENT_MODEL_ESCALATED=claude-opus-4-6
# DEV_AGENT_MODEL_ESCALATE_ON_RETRY=1
# DEV_AGENT_ANALYZE_TIMEOUT_SEC=1200

# Verify behavior
# DEV_AGENT_VERIFY_MODE=hybrid   # edited_only | hybrid | strict
# Scope/category hints are advisory only; verify pass/fail is driven by mode + enforcement toggles below.
# DEV_AGENT_CHECK_TIMEOUT_SEC=240
# DEV_AGENT_VERIFY_STRICT_OUTSIDE_MODIFIED=0
# DEV_AGENT_VERIFY_ENFORCE_COMPLETENESS=0
# DEV_AGENT_VERIFY_ENFORCE_SCHEMA_REFS=0
# DEV_AGENT_VERIFY_ENFORCE_DB_MIGRATION=1

# DB migration apply controls (Phase C)
# DEV_AGENT_DB_AUTO_APPLY_ENABLED=0
# DEV_AGENT_DB_APPLY_REQUIRES_CONFIRMATION=1
# DEV_AGENT_DB_APPLY_TARGET=dev
# DEV_AGENT_DB_APPLY_TOKEN=change-me
# DEV_AGENT_DB_APPLY_RPC_NAME=exec_sql
# DEV_AGENT_DB_APPLY_RPC_ARG=sql

# Staging/preview integration (Phase D1)
# Optional command to trigger deploy after branch push.
# Placeholders supported: {repo_path}, {branch}, {branch_slug}
# DEV_AGENT_STAGING_DEPLOY_COMMAND=
# Optional preview URL template for deterministic environments.
# Placeholders supported: {branch}, {branch_name}
# Example: https://{branch}.phwb.singforhope.org
# DEV_AGENT_STAGING_URL_TEMPLATE=
#
# Optional Vercel branch preview lookup (API-based fallback).
# Enable to auto-resolve a READY preview deployment URL by branch after push.
# DEV_AGENT_VERCEL_PREVIEW_ENABLED=1
# DEV_AGENT_VERCEL_TOKEN=vercel_token_here
# DEV_AGENT_VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxx
# DEV_AGENT_VERCEL_TEAM_ID=team_xxxxxxxxxxxxx    # Optional
# DEV_AGENT_VERCEL_LOOKBACK_MINUTES=240
# DEV_AGENT_VERCEL_POLL_TIMEOUT_SEC=300
# DEV_AGENT_VERCEL_POLL_INTERVAL_SEC=10
# DEV_AGENT_STAGING_REQUIRE_READY_BEFORE_HANDOFF=1

# PR handoff mode (Phase D2)
# after_staging_approval (default): no immediate PR when staging URL is available
# parallel_draft: create PR immediately (draft when staging URL exists)
# DEV_AGENT_PR_MODE=after_staging_approval
# DEV_AGENT_PR_DRAFT_ON_PARALLEL=1
